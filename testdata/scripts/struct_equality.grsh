# Struct equality: == compares FIELD-WISE, the way Go compares struct
# values. A *StructVal is a pointer, so before this it compared identities
# and called every separately-built pair of equal structs unequal.
type Point struct {
    X int
    Y int
}
type Segment struct {
    From  Point
    Label string
}

# Two literals, same fields, never the same instance.
fmt.Println("literals:", Point{1, 2} == Point{1, 2}, Point{1, 2} == Point{1, 3})

# b := a is a COPY, and a copy equals its original.
a := Point{3, 4}
b := a
b.Y = 4
fmt.Println("copy:", a == b, a != b)

# A struct-typed field is part of the value and compares with it.
s1 := Segment{Point{1, 2}, "edge"}
s2 := Segment{From: {1, 2}, Label: "edge"}
fmt.Println("nested:", s1 == s2, s1 == Segment{Point{9, 9}, "edge"})

# Values read back out of containers have no shared instance to lean on.
pts := []Point{{1, 2}, {5, 6}}
byName := map[string]Point{"origin": {0, 0}}
fmt.Println("containers:", pts[0] == Point{1, 2}, byName["origin"] == Point{})

# switch is the same operator, so it follows for free.
switch pts[1] {
case Point{1, 2}:
    fmt.Println("switch: first")
case Point{5, 6}:
    fmt.Println("switch: second")
default:
    fmt.Println("switch: neither")
}

# Equality composes with the shell side: a struct built from captured
# output compares to one written by hand.
name := $(echo origin)
fmt.Println("from shell:", byName[name] == Point{0, 0})
